    {
        "id": "cb3a47481de64985",
        "type": "function",
        "z": "ca0a860c66654d80",
        "name": "¿Ya está listo?",
        "func": "// Este nodo lee la ultima respuesta y decide si el bucle sigue o termina.\n// El modelo marca con el simbolo de tilde verde cuando considera que ya esta.\n// Pedimos al menos dos vueltas: la primera es un borrador, la segunda la mejora.\n\nconst mensajes = msg.state.messages || [];\nlet respuestas = 0;\nlet ultima = null;\n\nfor (const m of mensajes) {\n    const tipo = m && (m.type || m.role);\n    if (tipo === \"ai\" || tipo === \"assistant\") {\n        respuestas++;\n        ultima = m;\n    }\n}\n\nconst contenido = ultima ? (ultima.data ? ultima.data.content : ultima.content) : \"\";\nconst texto = typeof contenido === \"string\" ? contenido : JSON.stringify(contenido || \"\");\n\nif (respuestas >= 2 && texto.indexOf(\"✅\") !== -1) {\n    // Ya esta listo: sacamos la marca para que la respuesta final quede limpia.\n    const limpio = texto.replace(/✅/g, \"\").trim();\n    if (ultima.data) { ultima.data.content = limpio; } else { ultima.content = limpio; }\n    msg.state.next_node = \"end\";\n    node.status({ fill: \"green\", shape: \"dot\", text: \"criterio cumplido\" });\n} else if (respuestas >= 2) {\n    // Ya hubo mejora, pero el modelo no marco el final: otra vuelta.\n    msg.state.next_node = \"llm\";\n    node.status({ fill: \"yellow\", shape: \"dot\", text: \"falta la marca\" });\n} else {\n    // Primera respuesta: siempre dejamos que haya una segunda.\n    msg.state.next_node = \"llm\";\n    node.status({ fill: \"grey\", shape: \"dot\", text: \"borrador\" });\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
