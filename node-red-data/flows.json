    {
        "id": "a0809e32e8ef45dc",
        "type": "function",
        "z": "671bafab882a4047",
        "name": "¿Necesita una herramienta?",
        "func": "// Este nodo lee la ultima respuesta del modelo y decide el proximo paso.\n// Si el modelo pidio una herramienta con la marca [HERRAMIENTA:nombre:dato],\n// armamos el pedido y mandamos el mensaje por la salida \"tool\" del router.\n// Si no hay marca, la respuesta ya es la final y el grafo termina.\n\nconst mensajes = msg.state.messages || [];\nlet ultimaIA = null;\n\nfor (const m of mensajes) {\n    const tipo = m && (m.type || m.role);\n    if (tipo === \"ai\" || tipo === \"assistant\") {\n        ultimaIA = m;\n    }\n}\n\nconst contenido = ultimaIA ? (ultimaIA.data ? ultimaIA.data.content : ultimaIA.content) : \"\";\nconst texto = typeof contenido === \"string\" ? contenido : JSON.stringify(contenido || \"\");\nconst marca = texto.match(/\\[HERRAMIENTA:([A-Za-z0-9_-]+):([^\\]]*)\\]/);\n\nif (marca) {\n    // El modelo quiere un dato que no tiene: se lo pedimos al flujo.\n    msg.state.tool_request = {\n        name: marca[1].toLowerCase(),\n        input: marca[2].trim()\n    };\n    msg.state.next_node = \"tool\";\n    node.status({ fill: \"blue\", shape: \"dot\", text: \"pide \" + marca[1] });\n} else {\n    // No pidio nada: su respuesta es la definitiva.\n    msg.state.next_node = \"end\";\n    node.status({ fill: \"green\", shape: \"dot\", text: \"responde\" });\n}\n\nreturn msg;\n",
