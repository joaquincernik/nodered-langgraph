        "z": "a3b4bd84f3314c43",
        "name": "clima simulado",
        "func": "// Herramienta \"clima\": recibe un pedido y devuelve una respuesta.\n// El pedido llega como { name: \"clima\", input: \"Rosario\" }.\n// No hace falta nada especial: es un flujo normal de Node-RED.\n\nconst pedido = msg.payload || {};\nconst ciudad = String(pedido.input || \"\").trim() || \"una ciudad desconocida\";\nconst clave = ciudad.toLowerCase();\n\nconst datos = {\n    rosario: \"Soleado, 24 grados, viento leve del norte\",\n    \"buenos aires\": \"Parcialmente nublado, 21 grados, humedad alta\",\n    cordoba: \"Despejado, 27 grados, algo de viento\",\n    mendoza: \"Soleado y seco, 29 grados\"\n};\n\nconst clima = datos[clave] || \"No tengo datos de esa ciudad, pero el cielo esta despejado\";\n\n// Convencion comoda: devolver { output: \"...\" } y el nodo del agente\n// se queda solo con ese texto.\nmsg.payload = { output: \"Clima en \" + ciudad + \": \" + clima };\n\nnode.status({ fill: \"green\", shape: \"dot\", text: ciudad });\nreturn msg;\n",
