        "type": "function",
        "z": "bb5efee175413fed",
        "name": "Setter mensaje final",
        "func": "// Tomamos la lista de notas que devolvió MySQL\nlet listaNotas = msg.payload;\nlet textoRespuesta = \"\";\n\n// Verificamos si la lista está vacía\nif (listaNotas.length === 0) {\n    textoRespuesta = \"No tienes ninguna nota guardada.\";\n} else {\n    textoRespuesta = \"<b>Nota guardada</b>\\n\\n\";\n    let id = listaNotas[0].id;\n    let descripcion = listaNotas[0].descripcion;\n\n    // Agregamos la línea con el formato \"ID - Descripción\"\n    textoRespuesta = `${id} - ${descripcion}\\n`;\n\n}\n// Para el array\nmsg.payload = textoRespuesta;\nmsg.topic = \"Mensaje desde nodered\"\n\nlet mensajes = [];\n\nfor (let i = 0; i < msg.to.length; i++) {\n    mensajes.push({\n        to: msg.to[i],\n        topic: msg.topic,\n        payload: msg.payload\n    });\n}\n\nreturn [mensajes];\n",
        "outputs": 1,
