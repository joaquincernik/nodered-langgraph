    {
        "id": "0b07f0b99ecf3912",
        "type": "function",
        "z": "bb5efee175413fed",
        "name": "Setter mensaje final",
        "func": "// Tomamos la lista de notas que devolvió MySQL\nlet listaNotas = msg.payload;\nlet textoRespuesta = \"\";\n\n// Verificamos si la lista está vacía\nif (listaNotas.length === 0) {\n    textoRespuesta = \"No tienes ninguna nota guardada.\";\n} else {\n    textoRespuesta = \"<b>Notas guardadas</b>\\n\\n\";\n    \n    // Recorremos cada nota y armamos el texto\n    for (let i = 0; i < listaNotas.length; i++) {\n        let id = listaNotas[i].id;\n        let descripcion = listaNotas[i].descripcion;\n        \n        // Agregamos la línea con el formato \"ID - Descripción\"\n        textoRespuesta += `${id} - ${descripcion}\\n`;\n    }\n}\n\n// Recuperamos el Chat ID de la memoria del flujo \nlet chatId = flow.get(\"chatId\"); \n\n// Preparamos el mensaje final con la estructura que exige Telegram\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: textoRespuesta,\n    options: {\n        parse_mode: \"HTML\"\n    }\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 870,
        "y": 320,
        "wires": [
            [
                "643de01dc4563443"
            ]
        ]
    },
