    {
        "id": "96b783d2.a356b",
        "type": "function",
        "z": "b2f45a9dd0a68a25",
        "name": "",
        "func": "var authToken=msg.req.headers['x-auth-token'];\nmsg.auth= (authToken && authToken=='clave');\nif(!msg.auth){\n    msg.statusCode=401;\n}\nmsg.cabeceras=[];\n\nObject.keys(msg.req.headers).forEach(function(o,i)  {\n    msg.cabeceras.push({name:o, value:msg.req.headers[o]});\n});\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 350,
        "y": 440,
        "wires": [
            [
                "c2046f10.6850e"
            ]
        ]
    },
    {
        "id": "c2046f10.6850e",
        "type": "template",
        "z": "b2f45a9dd0a68a25",
        "name": "",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "mustache",
        "template": "<html>\n    <title>Headers</title>\n    <body>\n        {{#auth}}\n            <span style=\"color:green\">Autorizado!</span>\n        {{/auth}}\n        {{^auth}}\n            <span style=\"color:red\">No Autorizado</span>\n        {{/auth}}\n        <p>Cabeceras de petición recibidas</p>\n        <ul>\n        {{#cabeceras}}\n            <li>{{name}}={{value}}</li>\n        {{/cabeceras}}\n        <ul>\n    </body>\n</html>",
        "output": "str",
        "x": 480,
        "y": 440,
        "wires": [
            [
                "7b4d7749.258298"
            ]
        ]
    },
