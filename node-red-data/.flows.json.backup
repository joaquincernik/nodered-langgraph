        "name": "",
        "func": "\nlet b=Math.floor(Math.random()*100);\nnode.status({fill:\"green\",shape:\"ring\",text:`Fn(${b}) decorada!`});\nvar mensajes=[];\nmsg.payload.forEach((o,i)=>{\n    //node.warn(o);\n    mensajes.push({payload: o});\n});\n\nreturn [mensajes];\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
