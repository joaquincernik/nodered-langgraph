        "type": "function",
        "z": "8c33326fcebd957f",
        "g": "1f6b4d1d74a3c216",
        "name": "Cortar mensaje de nota",
        "func": "let textoCompleto = msg.payload.content; \nlet textoLimpio = textoCompleto.replace(\"/nota \", \"\");\nmsg.texto_nota = textoLimpio.trim();\nmsg.topic = `INSERT INTO tabla_notas (chat_id, descripcion) VALUES (?, ?);`\nmsg.payload = [flow.get(\"chatId\"),textoLimpio.trim()]\nmsg.tipoMessage = \"nota\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
