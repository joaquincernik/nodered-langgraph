        "id": "150f8ecb.7aa0c1",
        "type": "function",
        "z": "36e89b05.2d0714",
        "name": "Separar",
        "func": "if(msg.payload>=0 && msg.payload<=33) {\n    return [msg,null,null,null];\n} else if(msg.payload>33 && msg.payload<=66) {\n    return [null,msg,null,null];\n} else if(msg.payload>66 && msg.payload<=100) {\n    return [null,null,msg,null]; \n} else {\n    return [null,null,null,msg];\n}",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 280,
        "wires": [
